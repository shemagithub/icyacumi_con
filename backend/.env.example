# Public frontend origin (CORS + cookie)
FRONTEND_URL=http://localhost:3000

# Backend server
PORT=4000

# MySQL (Prisma) — same DB phpMyAdmin shows as "bone_koboyi"
DATABASE_URL="mysql://root@127.0.0.1:3306/bone_koboyi"
DATABASE_HOST="127.0.0.1"
DATABASE_PORT=3306
DATABASE_USER="root"
DATABASE_PASSWORD=
DATABASE_NAME="bone_koboyi"

# Must match root .env / .env.local exactly (JWT cookie for portal + admin + clients)
PORTAL_SESSION_SECRET=bone-koboyi-portal-dev-secret-change-me

# cPanel SMTP (SSL) — never commit real secrets
SMTP_HOST=icyacumi.com
SMTP_PORT=465
SMTP_USER=info@icyacumi.com
SMTP_PASS=
MAIL_FROM="ICYACUMI <info@icyacumi.com>"
NOTIFY_EMAIL=info@icyacumi.com

# XentriPay collections (MoMo + card). Never expose this key to the browser.
# Test dashboard: https://merchant.test.xentripay.com
# Live: https://xentripay.com
XENTRIPAY_API_KEY=
XENTRIPAY_BASE_URL=https://merchant.test.xentripay.com
