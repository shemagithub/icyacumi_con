# Public frontend origin (CORS + cookie)
FRONTEND_URL=http://localhost:3000

# Backend server
PORT=4000

# MySQL (Prisma) — same DB phpMyAdmin shows as "bone_koboyi"
DATABASE_URL="mysql://root@localhost:3306/bone_koboyi"
DATABASE_HOST="localhost"
DATABASE_PORT=3306
DATABASE_USER="root"
DATABASE_PASSWORD=
DATABASE_NAME="bone_koboyi"

# Must match root .env / .env.local exactly (JWT cookie for portal + admin + clients)
PORTAL_SESSION_SECRET=bone-koboyi-portal-dev-secret-change-me

# Gmail / SMTP (use an App Password — never commit real secrets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BONE KOBOYI <you@gmail.com>"
NOTIFY_EMAIL=
